# ColdGuard Environment Configuration
# Copy this file, rename it to .env, fill in your credentials
# Then restart: docker compose down && docker compose up

# ── Database (don't change unless you moved it) ──────────────────────────────
DATABASE_URL=postgresql://coldguard:coldguard_secret@db:5432/coldguard

# ── Anthropic (for Hindi/Marathi alert translation) ──────────────────────────
# Get key from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── WhatsApp Business API ─────────────────────────────────────────────────────
# Setup steps:
# 1. Go to https://developers.facebook.com
# 2. Create App → Business type → Add WhatsApp product
# 3. From WhatsApp > Getting Started:
#    - Copy "Phone number ID"  →  WHATSAPP_PHONE_ID
#    - Generate/copy token     →  WHATSAPP_TOKEN
# 4. Add test number to "To" list in the portal
# 5. Set WHATSAPP_ENABLED=true
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── SMS via fast2sms.com ──────────────────────────────────────────────────────
# Setup steps:
# 1. Sign up at https://www.fast2sms.com (free: 500 SMS/day)
# 2. Dashboard → Dev API → Copy your API key
# 3. Set SMS_ENABLED=true
SMS_ENABLED=false
SMS_API_KEY=

# ── Notification Behaviour ────────────────────────────────────────────────────
# Send only CRITICAL alerts (not warnings) via WhatsApp/SMS
NOTIFY_CRITICAL_ONLY=false

# Don't re-alert same facility within N minutes (prevents spam)
ALERT_COOLDOWN_MINUTES=30

# ── Auth ────────────────────────────────────────────────────────────────────
# Change this in production! Min 32 random characters.
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars

# Google OAuth (Admin login)
# 1. console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# 2. Add http://localhost:8000/api/auth/google/callback as redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
